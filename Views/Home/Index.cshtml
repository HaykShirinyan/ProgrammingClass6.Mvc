@{
    ViewData["Title"] = "Home Page";
}

<div style="margin-top: 100px;">
    <h3>Hot Items</h3>
    <div class="row">
        @foreach(var product in Model)
        {
            <div class="card" style="width: 18rem; margin-left: 30px; margin-bottom: 30px;">
                <a href="/Product/@product.Id"><img class="card-img-top" src="@product.Image" alt="Card image cap" style="width:262px; height:262px; object-fit:cover;"></a>
                <div class="card-body">
                    <a href="/Product/@product.Id"><h5 class="card-title">@product.Name</h5></a>
                    <a href="/Product/@product.Id"><p class="card-text">@product.Price$</p></a>
                    <a href="/Product/@product.Id"><p class="card-text text-warning mb-3">★★★★★</p></a>
                    <a href="/Cart/Add/@product.Id" class="btn btn-primary">Add to Cart</a>
                </div>
            </div>
        }
    </div>
</div>