@model EcomWebsite.Models.Products

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

<div class="container py-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <img src="@Model.Image" alt="Product Image">

            </div>
        </div>

        <div class="col-md-6">
            <h1 class="h2 mb-3">@Model.Name</h1>

            <div class="mb-3">
                <span class="h4">$@Model.Price</span>
            </div>

            <p class="mb-4">
                @Model.Description
            </p>

            <div class="d-grid gap-2">
                <a asp-controller="Checkout" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-primary">
                    Buy Now
                </a>
                <a asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="bi bi-cart me-1"></i>Add to Cart
                </a>
            </div>

            <div class="mt-4">
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-truck text-primary me-2"></i>
                    <span>Free shipping on orders over $50</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-undo text-primary me-2"></i>
                    <span>30-day return policy</span>
                </div>
                <div class="d-flex align-items-center">
                    <i class="fas fa-shield-alt text-primary me-2"></i>
                    <span>2-year warranty</span>
                </div>
            </div>
        </div>
    </div>
</div>