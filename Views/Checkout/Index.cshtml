@model EcomWebsite.Models.UserCredentials

<div class="container py-5">
    <h2 class="mb-4">Checkout</h2>

    <form asp-action="Index" method="post">
        <div class="mb-3">
            <label asp-for="Country" class="form-label">Country</label>
            <input asp-for="Country" class="form-control" placeholder="Enter your country" />
        </div>

        <div class="mb-3">
            <label asp-for="City" class="form-label">City</label>
            <input asp-for="City" class="form-control" placeholder="Enter your city" />
        </div>

        <div class="mb-3">
            <label asp-for="Street" class="form-label">Street</label>
            <input asp-for="Street" class="form-control" placeholder="Enter your street address" />
        </div>

        <div class="mb-3">
            <label asp-for="PostalCode" class="form-label">Postal Code</label>
            <input asp-for="PostalCode" class="form-control" placeholder="Enter your postal code" />
        </div>

        <h5 class="mt-4">Card Information</h5>

        <div class="mb-3">
            <label asp-for="CardNumber" class="form-label">Card Number</label>
            <input asp-for="CardNumber" class="form-control" placeholder="XXXX-XXXX-XXXX-XXXX" />
        </div>

        <div class="mb-3">
            <label asp-for="CardHolder" class="form-label">Card Holder</label>
            <input asp-for="CardHolder" class="form-control" placeholder="Name on card" />
        </div>

        <div class="row mb-3">
            <div class="col">
                <label asp-for="CardDate" class="form-label">Expiration Date</label>
                <input asp-for="CardDate" class="form-control" placeholder="MM/YY" />
            </div>
            <div class="col">
                <label asp-for="CardCvc" class="form-label">CVC</label>
                <input asp-for="CardCvc" class="form-control" placeholder="123" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Place Order</button>
    </form>
</div>
