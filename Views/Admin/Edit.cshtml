@model EcomWebsite.Models.Products

<h1 class="mb-4 text-center">Create New Listing</h1>

<form asp-action="Edit" method="post" class="container mt-4" style="max-width:500px;">
  
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input asp-for="Name" class="form-control" placeholder="Enter product name">
  </div>

  <div class="mb-3">
    <label class="form-label">Description</label>
    <input asp-for="Description" class="form-control" placeholder="Enter description">
  </div>

  <div class="mb-3">
    <label class="form-label">Image URL</label>
    <input asp-for="Image" class="form-control" placeholder="Enter image URL">
  </div>

  <div class="mb-3">
    <label class="form-label">Price</label>
    <input asp-for="Price" class="form-control" placeholder="Enter price" type="number">
  </div>

  <button type="submit" class="btn btn-primary w-100">Update</button>
</form>