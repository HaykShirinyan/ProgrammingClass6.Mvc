@model EcomWebsite.Models.Products

<h1 class="mb-4 text-center">Create New Listing</h1>

<form asp-action="Create" method="post" class="container mt-4" enctype="multipart/form-data" style="max-width:500px;">
  
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input asp-for="Name" class="form-control" placeholder="Enter product name">
  </div>

  <div class="mb-3">
    <label class="form-label">Description</label>
    <input asp-for="Description" class="form-control" placeholder="Enter description">
  </div>

  <div class="mb-3">
    <label class="form-label">Price</label>
    <input asp-for="Price" class="form-control" placeholder="Enter price" type="number">
  </div>

  <div class="mb-3">
    <label class="form-label">Upload Image</label>
    <input asp-for="Image" class="form-control" type="file" name="ImageFile">
  </div>

  <button type="submit" class="btn btn-primary w-100">Create Listing</button>
</form>