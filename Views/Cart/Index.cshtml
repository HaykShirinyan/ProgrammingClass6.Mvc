@model IEnumerable<EcomWebsite.Models.Products>

<h1>Cart</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Checkout</th>
            <th>Remove</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var products in Model)
        {
            <tr>
                <td><img src="@products.Image" alt="@products.Name" style="height:60px;" /></td>
                <td>@products.Name</td>
                <td>$@products.Price</td>
                <td>
                    <a class="btn btn-success" asp-controller="Checkout" asp-action="CheckoutItem" asp-route-id="@products.Id"> Purches</a>
                </td>
                <td>
                    @{
                        var cartItemId = (ViewBag.CartItems as List<EcomWebsite.Models.CartItems>)
                        .FirstOrDefault(c => c.ProductId == products.Id)?.Id;
                    }

                    @if (cartItemId != null)
                    {
                        <a class="btn btn-danger" href="/Cart/Delete/@cartItemId">
                            Remove
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>