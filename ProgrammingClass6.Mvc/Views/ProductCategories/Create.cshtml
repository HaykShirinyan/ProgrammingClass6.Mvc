@model ProductCategoriesViewModels

@*  
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <form asp-controller="ProductCategories" asp-action="Create">
        <div class="mb-3">
            <label asp-for="ProductCategory.ProductId" class="form-label">
                Product
            </label>
            <input asp-for="ProductCategory.ProductId" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="ProductCategory.CategoryId" class="form-label">
                Category
            </label>
            <select asp-for="ProductCategory.CategoryId" class="form-control">
                <option>-- Please Select --</option>

                @foreach (ProductCategory category in Model.ProductCategories)
                {   <option value="@category.CategoryId">
                        @category.Category
                    </option>   
                }
            </select>
        </div>

        <div>
            <a class="btn btn-secondary" 
                asp-controller="ProductCategories" 
                asp-action="Index"
               asp-route-productId="@Model.Product.Id">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Save
            </button>
        </div>
    </form>
</div>