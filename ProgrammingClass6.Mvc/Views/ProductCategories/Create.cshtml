@model CategoriesViewModel

<div>
    <form asp-controller="ProductCategories" asp-action="Create" method="post">
        <!-- Hidden field for ProductId -->
        <input type="hidden" name="productId" value="@Model.Product.Id" />

        <!-- Display product name (readonly) -->
        <div class="mb-3">
            <label class="form-label">Product</label>
            <input type="text" class="form-control" value="@Model.Product.Name" readonly />
        </div>

        <!-- Dropdown for selecting category -->
        <div class="mb-3">
            <label asp-for="SelectedCategoryId" class="form-label">Category</label>
            <select asp-for="SelectedCategoryId" class="form-control">
                <option value="">-- Please Select --</option>
                @foreach (var category in Model.Categories as List<Category>)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>

        <!-- Form buttons -->
        <div>
            <a class="btn btn-secondary" 
               asp-controller="ProductCategories" 
               asp-action="Index"
               asp-route-productId="@Model.Product.Id">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Save
            </button>
        </div>
    </form>
</div>
