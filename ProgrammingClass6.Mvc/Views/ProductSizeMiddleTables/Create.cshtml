@model ProgrammingClass6.Mvc.ViewModels.ProductSizeMiddleTableViewModel

<div>
    <form asp-controller="ProductSizeMiddleTables" asp-action="Create" method="post">
        <input type="hidden" asp-for="ProductSizeMiddleTable.ProductId" />

        <div class="mb-3">
            <label asp-for="ProductSizeMiddleTable.ProductId" class="form-label">Product</label>
            <input asp-for="ProductSizeMiddleTable.ProductId" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="ProductSizeMiddleTable.ProductSizeId" class="form-label">Product Size</label>
            <select asp-for="ProductSizeMiddleTable.ProductSizeId" class="form-control">
                <option value="">-- Please Select --</option>
                @foreach (var productSize in Model.ProductSizes)
                {
                    <option value="@productSize.Id">@productSize.Name</option>
                }
            </select>
        </div>

        <div>
            <a class="btn btn-secondary"
               asp-controller="ProductSizeMiddleTables"
               asp-action="Index"
               asp-route-productId="@Model.ProductSizeMiddleTable.ProductId">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
