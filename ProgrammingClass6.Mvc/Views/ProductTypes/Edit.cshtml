@model ProductTypeViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<form asp-controller="ProductTypes" asp-action="Edit">
    <div class="mb-3">
        <label asp-for="ProductType.Id" class="form-label">
            Id
        </label>
        <input asp-for="ProductType.Id" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label asp-for="ProductType.Name" class="form-label">Name</label>
        <input asp-for="ProductType.Name" class="form-control" />
        <span asp-validation-for="ProductType.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductType.Brand" class="form-label">Brand</label>
        <textarea asp-for="ProductType.Brand" class="form-control"></textarea>
        <span asp-validation-for="ProductType.Brand" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductType.Type" class="form-label">Type</label>
        <input asp-for="ProductType.Type" class="form-control" />
        <span asp-validation-for="ProductType.Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductType.Price" class="form-label">Price</label>
        <input asp-for="ProductType.Price" class="form-control" />
        <span asp-validation-for="ProductType.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductType.Quantity" class="form-label">Quantity</label>
        <input asp-for="ProductType.Quantity" class="form-control" />
        <span asp-validation-for="ProductType.Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProductType.ManufacturerId" class="form-label">
            Manufacturer
        </label>
        <select asp-for="ProductType.ManufacturerId" class="form-control">
            <option></option>
            @foreach (var manufacturer in Model.Manufacturers)
            {
                <option value="@manufacturer.Id">
                    @manufacturer.Name
                </option>
            }
        </select>
    </div>
    <div>
        <a class="btn btn-secondary" asp-controller="ProductTypes" asp-action="Index">
            Cancel
        </a>
        <button class="btn btn-primary" type="submit">
            Save
        </button>
    </div>

</form>