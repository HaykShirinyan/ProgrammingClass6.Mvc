@model ProductTypeItemViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1 class="h3">
    Shopping Cart
</h1>
<form asp-controller="ProductTypes" asp-action="Cart">
    <div class="mb-3">
        <label asp-for="ProductType.Name" class="form-label">Id</label>
        <input asp-for="ProductType.Name" class="form-control" readonly/>
        <span asp-validation-for="ProductType.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProductType.Quantity" class="form-label">Quantity</label>
        <input asp-for="ProductType.Quantity" class="form-control" />
        <span asp-validation-for="ProductType.Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProductType.Price" class="form-label">Price</label>
        <input asp-for="ProductType.Price" class="form-control" />
        <span asp-validation-for="ProductType.Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProductType.Brand" class="form-label">Total Price</label>
        <input asp-for="ProductType.Brand" class="form-control" readonly />
        <span asp-validation-for="ProductType.Brand" class="text-danger"></span>
    </div>
    @foreach (var productType in Model.ProductTypes)
    {
        <div class="mb-3">
            <label class="form-label">Item Name</label>
            <input class="form-control" value="@productType.Name" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Quantity</label>
            <input class="form-control" value="@productType.Brand" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Price</label>
            <input class="form-control" value="@productType.Price" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Total Price</label>
            <input class="form-control" value="@productType.Quantity" readonly />
        </div>
    }
    <div>
        <a class="btn btn-secondary" asp-controller="ProductTypes" asp-action="Index">
            Continue Shopping
        </a>
        <button class="btn btn-primary" type="submit">
            Checkout
        </button>
    </div>

</form>