@model List<ProductTypeCart>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1 class="h3">
    Shopping Cart
</h1>

<form asp-controller="ProductTypes" asp-action="Cart">
    @foreach (var productTypeCart in Model)
    {
        <div class="card mb-4 shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@productTypeCart.Name</h5>
                <form asp-controller="ProductTypes"
                      asp-action="Remove"
                      asp-route-id="@productTypeCart.Id"
                      method="get">
                    <button type="submit" class="btn btn-danger btn-sm">
                        Remove
                    </button>
                </form>
            </div>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" value="@productTypeCart.Name" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Brand</label>
                <input class="form-control" value="@productTypeCart.Brand" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Type</label>
                <input class="form-control" value="@productTypeCart.Type" />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input class="form-control" value="@productTypeCart.Price" />
            </div>
            <div class="mb-3">
                <label class="form-label">Total Price</label>
                <input class="form-control" value="@productTypeCart.TotalPrice" readonly />
            </div>
        </div>
    }
    <div>
        <a class="btn btn-secondary" asp-controller="ProductTypes" asp-action="Index">
            Continue Shopping
        </a>
        <button class="btn btn-primary" type="submit">
            Checkout
        </button>
    </div>
</form>