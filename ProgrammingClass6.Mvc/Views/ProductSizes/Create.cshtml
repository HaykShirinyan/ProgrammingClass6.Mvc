@model ProductSizeViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
 <form asp-controller="ProductSizes" asp-action="Create">
     <div class="mb-3">
         <label asp-for="ProductSize.ProductId" class="form-label">
                Product 
          </label>
            <input asp-for="ProductSize.ProductId" class="form-control" readonly />
     </div>
     <div class="mb-3">
            <label asp-for="ProductSize.SizeId" class="form-label">
             Size
         </label>
            <select asp-for="ProductSize.SizeId" class="form-control">
                <option></option>
               
                @foreach (var size in Model.Sizes as List<Size>)
                {
                    <option value="@size.Id">
                        @size.Name
                    </option>
                }
            </select>
     </div>
     <div>
         <a class="btn btn-secondary"
         asp-controller="ProductSizes"
         asp-action="Index"
               asp-route-productId="@Model.ProductSize.ProductId">
             Cancel
         </a>
            <button type="submit" class="btn btn-primary">
                Save
            </button>
     </div>
 </form>
</div>
