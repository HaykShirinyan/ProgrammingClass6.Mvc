@model UnitOfMeasureViewModel

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<form asp-controller="UnitOfMeasures" asp-action="Edit">
        
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.Id" class="form-label">
            Id
        </label>
        <input asp-for="UnitOfMeasure.Id" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.Name" class="form-label">Name</label>
        <input asp-for="UnitOfMeasure.Name" class="form-control" />
        <span asp-validation-for="UnitOfMeasure.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.Type" class="form-label">Type</label>
        <input asp-for="UnitOfMeasure.Type" class="form-control" />
        <span asp-validation-for="UnitOfMeasure.Type" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.UnitOfMeasureValue" class="form-label">Unit Of Measure Value</label>
        <input asp-for="UnitOfMeasure.UnitOfMeasureValue" class="form-control" />
        <span asp-validation-for="UnitOfMeasure.UnitOfMeasureValue" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.Price" class="form-label">Price</label>
        <input asp-for="UnitOfMeasure.Price" class="form-control" />
        <span asp-validation-for="UnitOfMeasure.Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.Quantity" class="form-label">Quantity</label>
        <input asp-for="UnitOfMeasure.Quantity" class="form-control" />
        <span asp-validation-for="UnitOfMeasure.Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitOfMeasure.UnitOfMeasureValueId" class="form-label">
            UnitOfMeasureValu
        </label>
        <select asp-for="UnitOfMeasure.UnitOfMeasureValueId" class="form-control">
            <option>

            </option>
            @foreach (var unitOfMeasureValue in Model.UnitOfMeasureValues)
            {
                <option value="@unitOfMeasureValue.Id">
                    @unitOfMeasureValue.Name
                </option>
            }
        </select>
    </div>
    <div class="mb-3">
        <a class="btn btn-secondary" asp-controller="UnitOfMeasures" asp-action="Index">
            Cancel
        </a>
        <button class="btn btn-primary" type="submit">
            Save
        </button>
    </div>

</form>