@model ProductColorViewModel

<div>
    <form asp-controller="ProductColors" asp-action="Create" method="post">
        <input type="hidden" asp-for="ProductColor.ProductId" />

        <div class="mb-3">
            <label asp-for="ProductColor.ProductId" class="form-label">Product</label>
            <input asp-for="ProductColor.ProductId" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="ProductColor.ColorId" class="form-label">Color</label>
            <select asp-for="ProductColor.ColorId" class="form-control">
                <option value="">-- Please Select --</option>
                @foreach (var color in Model.Colors)
                {
                    <option value="@color.Id">@color.Name</option>
                }
            </select>
        </div>

        <div>
            <a class="btn btn-secondary"
               asp-controller="ProductColors"
               asp-action="Index"
               asp-route-productId="@Model.ProductColor.ProductId">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
