@model ProductColorsViewModels

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div>
    <form asp-controller="ProductColors" asp-action="Create">
        <div class="mb-3">
            <label asp-for="ProductColor.ProductId" class="form-label">
                Product
            </label>
            <input asp-for="ProductColor.ProductId" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="ProductColor.ColorId" class="form-label">
                Color
            </label>
            <select asp-for="ProductColor.ColorId" class="form-control">
                <option>---Pleas Select---</option>

                @foreach (ProductColor color in Model.ProductColors)
                {  
                    <option value="@color.ColorId">
                        @color.Color
                    </option> 
                }
            </select>
        </div>

        <div>
            <a class="btn btn-secondary"
               asp-controller="ProductColors" asp-action="Index" asp-route-productId="@Model.ProductColor.ProductId">
                Cancol
            </a>

            <button type="submit" class="btn btn-primary"> Save </button>
        </div>
    </form>
</div>